---
import { Image } from 'astro:assets';
import type { Profile } from '../lib/cv';

interface Props {
  profile: Profile;
  /** Rendered lead paragraph (the profile.md body). */
  lead: any;
}
const { profile, lead: Lead } = Astro.props;
const p = profile.data;
---

<header class="hero">
  <p class="status">
    <span>{p.status.left}</span>
    <span>{p.status.right}</span>
  </p>
  <div class="body">
    <div class="text">
      <p class="eyebrow" data-reveal>{p.title}</p>
      <h1 data-reveal>{p.headline}</h1>
      <div class="lead" data-reveal><Lead /></div>
    </div>
    <figure class="portrait">
      <Image
        src={p.portrait}
        alt={p.name}
        widths={[280, 420, 500]}
        sizes="(max-width: 760px) calc(100vw - 40px), 280px"
        priority
      />
    </figure>
  </div>
</header>

<style>
  .hero {
    background: var(--dark);
    color: var(--dark-text);
  }
  .status {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 20px var(--pad-x);
    border-bottom: 1px solid var(--dark-hairline);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dark-label);
  }
  .body {
    display: flex;
    align-items: flex-end;
    gap: clamp(28px, 4vw, 56px);
    flex-wrap: wrap;
    padding: clamp(48px, 7vw, 88px) var(--pad-x) clamp(48px, 7vw, 80px);
  }
  .text {
    flex: 1 1 420px;
    min-width: 0;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent-on-dark);
    margin-bottom: 30px;
  }
  h1 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
    margin: 0 0 28px;
  }
  .lead :global(p) {
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.65;
    color: var(--dark-muted);
    max-width: 660px;
    text-wrap: pretty;
  }
  .lead :global(p + p) {
    margin-top: 1em;
  }
  .portrait {
    flex: 0 1 280px;
    min-width: 220px;
    aspect-ratio: 5 / 6;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
