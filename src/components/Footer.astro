---
import type { Profile } from '../lib/cv';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const { footer, contact } = profile.data;
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const telHref = 'tel:' + contact.phone.replace(/[^\d+]/g, '');
---

<footer class="contact" id="contact">
  <div data-reveal>
    <h2 class="heading">{footer.heading}</h2>
    <p class="note">{footer.note}</p>
  </div>
  <address data-reveal>
    <div><a class="email" href={`mailto:${contact.email}`}>{contact.email}</a></div>
    <div><a class="plain" href={telHref}>{contact.phone}</a></div>
    <div><a href={contact.website} rel="me">{bare(contact.website)}</a></div>
    <div><a href={contact.linkedin} rel="me">{bare(contact.linkedin)}</a></div>
  </address>
</footer>

<style>
  .contact {
    background: var(--dark);
    color: var(--dark-text);
    padding: clamp(48px, 7vw, 80px) var(--pad-x);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 36px;
    flex-wrap: wrap;
  }
  .heading {
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .note {
    font-size: 15px;
    color: var(--dark-label);
    margin-top: 16px;
  }
  address {
    font-size: 16px;
    line-height: 2;
    text-align: right;
    min-width: 260px;
  }
  address a {
    color: var(--dark-text);
  }
  address .email {
    color: var(--accent-on-dark);
  }
</style>
